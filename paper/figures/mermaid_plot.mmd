---
config:
  flowchart:
    defaultRenderer: elk
    nodeSpacing: 120
    rankSpacing: 160
    padding: 32
    wrappingWidth: 500
    titleTopMargin: 36
    curve: linear
  theme: base
  themeVariables:
    fontSize: 30px
    background: '#F4F9FF'
  block:
    padding: 16
  layout: dagre
---
flowchart TB
 subgraph I_Top["<b>o/p pred inv</b>"]
    direction LR
        I_LLM1(["LLM"])
        I_OP@{ label: "<b>(C1)</b> Output Prediction Prompt<br>(Infer z from X', dec by inverting dec to enc)" }
        I_dec["dec"]
        I_Xp_in@{ label: "X'" }
  end
 subgraph I_Bot["<b>i/p pred inv</b>"]
    direction LR
        I_Xp_out@{ label: "X'" }
        I_LLM2(["LLM"])
        I_IP@{ label: "<b>(C2)</b> Input Prediction Prompt<br>(Infer X' from z, dec by inverting dec to enc)" }
        I_z["z"]
  end
 subgraph Invertible[" "]
    direction TB
        IA_Title["(C) Execution<br>Reasoning<br>with<br>Invertibility"]
        I_Top
        I_Bot
  end
 subgraph F_Top["<b>o/p pred</b>"]
    direction LR
        F_LLM1(["LLM"])
        F_OP["<b>(B1)</b> Output Prediction Prompt<br>(Predict z from X, enc)"]
        F_enc["enc"]
        F_X_in["X"]
  end
 subgraph F_Bot["<b>i/p pred</b>"]
    direction LR
        F_X_out["X"]
        F_LLM2(["LLM"])
        F_IP["<b>(B2)</b> Input Prediction Prompt<br>(Predict X from z, enc)"]
        F_z["z"]
  end
 subgraph Forward[" "]
    direction TB
        IB_Title["(B) Execution<br>Reasoning"]
        F_Top
        F_Bot
  end
 subgraph Compression[" "]
    direction LR
        IC_Title["(A) Basic Compression Pipeline"]
        C_X["X"]
        C_enc["enc"]
        C_z["z"]
        C_dec["dec"]
        C_Xp@{ label: "X'" }
  end
    I_Xp_in --> I_dec
    I_dec --> I_OP & I_IP
    I_OP --> I_LLM1
    I_LLM1 --> I_z
    I_z --> I_IP
    I_IP --> I_LLM2
    I_LLM2 --> I_Xp_out
    F_X_in --> F_enc
    F_enc --> F_OP & F_IP
    F_OP --> F_LLM1
    F_LLM1 --> F_z
    F_z --> F_IP
    F_IP --> F_LLM2
    F_LLM2 --> F_X_out
    C_X --> C_enc
    C_enc --> C_z
    C_z --> C_dec
    C_dec --> C_Xp
    I_Bot --> Invertible
    I_OP@{ shape: rect}
    I_Xp_in@{ shape: rect}
    I_Xp_out@{ shape: rect}
    I_IP@{ shape: rect}
    C_Xp@{ shape: rect}
     I_LLM1:::llm
     I_OP:::task
     I_dec:::decoding
     I_Xp_in:::recon
     I_Xp_out:::recon
     I_LLM2:::llm
     I_IP:::task
     I_z:::latent
     IA_Title:::whiteBox
     IA_Title:::Ash
     F_LLM1:::llm
     F_OP:::task
     F_enc:::encoding
     F_X_in:::input
     F_X_out:::input
     F_LLM2:::llm
     F_IP:::task
     F_z:::latent
     IB_Title:::whiteBox
     IB_Title:::Ash
     IC_Title:::whiteBox
     IC_Title:::Ash
     C_X:::input
     C_enc:::encoding
     C_z:::latent
     C_dec:::decoding
     C_Xp:::recon
    classDef input    fill:#E3F2FD,stroke:#1E88E5,stroke-width:2px,rounded
    classDef encoding fill:#FFF3E0,stroke:#FB8C00,stroke-width:2px,rounded
    classDef latent   fill:#F3E5F5,stroke:#8E24AA,stroke-width:2px,rounded
    classDef decoding fill:#E8F5E9,stroke:#43A047,stroke-width:2px,rounded
    classDef recon    fill:#FFEBEE,stroke:#E53935,stroke-width:2px,rounded
    classDef task     fill:#FFFDE7,stroke:#FDD835,stroke-width:2px,rounded
    classDef llm      fill:#E0F7FA,stroke:#00838F,stroke-width:2px,rounded
    classDef whiteBox fill:#ffffff,stroke:#333333,stroke-width:2px,rounded,font-weight:bold
    classDef Ash stroke-width:1px, stroke-dasharray:none, stroke:#999999, fill:#EEEEEE, color:#000000
    style I_Top color:#FF6D00
    style I_Bot color:#FF6D00
    style F_Top color:#FF6D00
    style F_Bot color:#FF6D00
