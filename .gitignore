# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data — exclude large generated files but track small inputs/results
data/raw/
data/processed/**/*_gens_*.jsonl
data/processed/**/*_verified.jsonl
# Track: data.jsonl (inputs), *_msg.jsonl (prompts), *_verified.csv (results)

# Logs
logs/

# Temp / scratch
temp/
*.tmp
*.local_backup

# Environment markers
.env_installed
.env

# OS / editor junk
.DS_Store
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
